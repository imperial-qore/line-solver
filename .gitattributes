# Source files
# ============
*.m             text diff=matlab
*.ipynb         filter=nbstripout diff=ipynb
* text=auto
* text eol=lf

# Binary files (must come after text rules)
# MEX artifacts are ELF/PE objects: without these the `* text eol=lf` rule above
# rewrites every CRLF byte pair inside them and commits a truncated, unloadable
# binary (it had already silently damaged three cache_*_mex.mexa64 blobs).
# The same applies to .mat/.jar/.zip/.pdf: declaring them binary ABOVE the
# catch-all left eol=lf winning by last-match, damaging gausslegendre-data.mat.
*.mat           binary
*.jar           binary
*.zip           binary
*.pdf           binary
*.mexa64        binary
*.mexw64        binary
*.mexmaci64     binary
*.mexmaca64     binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           binary

# Exclude JAR and MATLAB source from GitHub language statistics
jar/** linguist-vendored
matlab/** linguist-vendored

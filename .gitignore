# common/ holds build outputs. The root one lists its CONTENTS rather than the
# directory, because git cannot re-include a file whose parent directory is
# excluded and the learned AUTO selector below must survive a fresh clone.
# A pattern with an interior slash is anchored to this file, so the nested
# common/ directories need their own rules.
/common/*
# The learned AUTO selector is a source artifact, not a build output: all three
# backends read it at run time.
!/common/algsel-model.json
python/common/
io/rest-api/common/
console.out
scratch.py
deploy.sh
dist/
regression/
hs_err*
line_solver.egg-info
setup.cfg
test.ipynb

# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025a
startdir = /home/gcasale/Dropbox/code/line-dev.git/matlab/src/api/pfqn

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_panacea_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=pfqn_panacea_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o pfqn_panacea_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_panacea.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o pfqn_panacea_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,pfqn_panacea.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/pfqn_panacea_data.o : cc $root/pfqn_panacea_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/pfqn_panacea_initialize.o : cc $root/pfqn_panacea_initialize.c
build $builddir/pfqn_panacea_terminate.o : cc $root/pfqn_panacea_terminate.c
build $builddir/pfqn_panacea.o : cc $root/pfqn_panacea.c
build $builddir/sum.o : cc $root/sum.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/assertCompatibleDims.o : cc $root/assertCompatibleDims.c
build $builddir/pfqn_ca.o : cc $root/pfqn_ca.c
build $builddir/prod.o : cc $root/prod.c
build $builddir/_coder_pfqn_panacea_api.o : cc $root/interface/_coder_pfqn_panacea_api.c
build $builddir/_coder_pfqn_panacea_mex.o : cc $root/interface/_coder_pfqn_panacea_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/applyScalarFunctionInPlace.o : cc $root/applyScalarFunctionInPlace.c
build $builddir/log.o : cc $root/log.c
build $builddir/div.o : cc $root/div.c
build $builddir/pfqn_panacea_emxutil.o : cc $root/pfqn_panacea_emxutil.c
build $builddir/_coder_pfqn_panacea_info.o : cc $root/interface/_coder_pfqn_panacea_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/pfqn_panacea_mex.mexa64 : link $builddir/pfqn_panacea_data.o $builddir/rt_nonfinite.o $builddir/pfqn_panacea_initialize.o $builddir/pfqn_panacea_terminate.o $builddir/pfqn_panacea.o $builddir/sum.o $builddir/sumMatrixIncludeNaN.o $builddir/repmat.o $builddir/assertCompatibleDims.o $builddir/pfqn_ca.o $builddir/prod.o $builddir/_coder_pfqn_panacea_api.o $builddir/_coder_pfqn_panacea_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/applyScalarFunctionInPlace.o $builddir/log.o $builddir/div.o $builddir/pfqn_panacea_emxutil.o $builddir/_coder_pfqn_panacea_info.o $builddir/c_mexapi_version.o 
